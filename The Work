<!DOCTYPE html>
<html>
<head>
    <title>My One Page Website</title>
</head>

<body>

    <nav>
        <a href="#home">Home</a> |
        <a href="#pictures">Pictures</a> |
        <a href="#video">Video</a> |
        <a href="#contact">Contact</a>
    </nav>

    <section id="home">
        <h1>Welcome to My Website</h1>
        <p>This is my one-page website. Welcome to my site!</p>
    </section>

    <section id="pictures">
        <h2>Pictures</h2>
        <p>Here are some pictures.</p>

        <img src="https://picsum.photos/300/200" alt="A picture">
        <img src="https://picsum.photos/301/200" alt="Another picture">
    </section>

    <section id="video">
        <h2>Video</h2>

        <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/dQw4w9WgXcQ"
            title="YouTube video"
            allowfullscreen>
        </iframe>
    </section>

    <section id="contact">
        <h2>Contact Me</h2>

        <form>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name">

            <br><br>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email">

            <br><br>

            <label for="message">Message:</label>
            <input type="text" id="message" name="message">

            <br><br>

            <input type="submit" value="Submit">
        </form>
    </section>

    <footer>
        <p>Copyright 2026 My One Page Website</p>
    </footer>

</body>
</html>
